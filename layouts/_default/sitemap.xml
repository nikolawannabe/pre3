{{- /*
  The sitemap for search engines: Hugo's own, minus event pages that are only for enrolled families
  (partials/event-audience.html), so they aren't advertised.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Pages }}
    {{- if and (eq .Section "events") .IsPage (eq (partial "event-audience.html" .) "families") }}{{ continue }}{{ end }}
    {{- if .Sitemap.Disable }}{{ continue }}{{ end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
</urlset>
